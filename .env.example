# Dev server (docker-compose.yml maps 3101)
PORT=3101

# Recommended production stack (env-driven; no extra SDK config files required):
#   Netlify (host) + Neon (Postgres) + GitHub OAuth (admin) + Resend (contact)
#   + Google reCAPTCHA + Cloudflare DNS (optional CDN tag purge) + Sentry
#   + Disqus (blog comments) + GA / Meta Pixel
# Repo configs: netlify.toml, drizzle.config.ts, instrumentation*.ts, public/_headers

# Feature flags (0 = off, 1 = on). Defaults keep forks landing-only.
# Server FEATURE_* gates routes/APIs (must be exactly "1").
# NEXT_PUBLIC_* mirrors drive client nav only — set BOTH when enabling a module.
FEATURE_BLOG=0
FEATURE_CONTACT=0
NEXT_PUBLIC_FEATURE_BLOG=0
NEXT_PUBLIC_FEATURE_CONTACT=0

# Site identity (required for landing + discovery defaults)
APP_SITE_NAME=Dockershelf
SITE_APP_NAME=Dockershelf
SITE_DESCRIPTION="Useful, lightweight, and reliable Docker images for Debian, Python, Node, Go, and LaTeX — rebuilt and tested weekly."
SITE_KEYWORDS="docker, debian, python, node, go, latex, docker images, containers, dockershelf"
CANONICAL_SITE_URL=https://dockershelf.com
NEXT_PUBLIC_SITE_URL=https://dockershelf.com
SITE_AUTHOR_NAME="Luis Alejandro"
SITE_AUTHOR_FIRST_NAME=Luis
SITE_AUTHOR_LAST_NAME=Alejandro
SITE_AUTHOR_EMAIL=luis@luisalejandro.org
SITE_AUTHOR_GITHUB=Dockershelf/dockershelf
SITE_AUTHOR_TWITTER=LuisAlejandro
SITE_AUTHOR_FACEBOOK=
SITE_BLOG_TWITTER=
SITE_BLOG_FACEBOOK=
SITE_BLOG_FB_APP_ID=
SITE_PROFILE_DATE_CREATED=2016-06-08T00:00:00+00:00
SITE_PROFILE_DATE_MODIFIED=2026-07-11T00:00:00+00:00

# Public site configuration (use "local" for http://localhost:3101)
NEXT_PUBLIC_ENV_NAME=local

# Analytics keepers (optional). Empty = disabled. Skipped when ENV_NAME=local.
# AdSense is removed — do not add publisher/slot IDs.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Contact form (required when FEATURE_CONTACT=1)
NEXT_PUBLIC_RECAPTCHA_API_KEY=
RECAPTCHA_API_SECRET=
NEXT_PUBLIC_JWT_SECRET=

# Optional blog comments (Disqus embed uses shortname only)
NEXT_PUBLIC_DISQUS_SHORTNAME=
# Unused by current UI (legacy comment-count API). Safe to leave empty.
DISQUS_API_KEY=

# On-demand revalidation + CDN purge
# Blog admin publish/unpublish fails closed without Netlify purge credentials.
REVALIDATE_SECRET=
NETLIFY_PURGE_TOKEN=
NETLIFY_SITE_ID=
# Optional: Cloudflare DNS zone + API token for Cache-Tag purge (alongside Netlify)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Error monitoring (Sentry) — optional
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Contact (Resend) — required when FEATURE_CONTACT=1
# Verify the sending domain in Resend before production use.
RESEND_API_KEY=
EMAIL_FROM=noreply@dockershelf.com
EMAIL_FROM_NAME=Dockershelf
CONTACT_TO=luis@luisalejandro.org

# Optional contact side effects (Mailchimp / Google Sheets) — non-blocking
MAILCHIMP_API_BASE_URL=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SPREADSHEET_NAME=

# Blog (Neon + Better Auth) — required when FEATURE_BLOG=1
# DATABASE_URL: pooled Neon connection string (runtime neon-http public reads)
# DATABASE_URL_UNPOOLED: direct Neon URL — required for drizzle-kit migrate AND
# the Better Auth WebSocket Pool (do not use the pooled URL for the auth pool)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Better Auth — fail-fast at auth module init when FEATURE_BLOG=1 and any are missing
BETTER_AUTH_SECRET=
# Public base URL of this app (local: http://localhost:3101).
# GitHub OAuth callback: {BETTER_AUTH_URL}/api/auth/callback/github
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated admin emails (case-insensitive). Empty/unset ⇒ deny all admin (fail-closed).
# Admins need a primary email on the GitHub account (user:email scope).
ADMIN_EMAIL_ALLOWLIST=
