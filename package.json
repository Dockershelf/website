    "react-icons": "^5.6.0",
    "react-imgix": "^9.11.0",
    "react-is": "^19.2.7",
    "react-photo-album": "^3.6.0",
    "react-player": "^3.4.0",
    "react-scrollmagic": "^2.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "resend": "^6.17.2",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
