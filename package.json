    "@sentry/nextjs": "^10.63.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.0.1",
