{
  "name": "dockershelf-website",
  "version": "0.1.1",
  "description": "Dockershelf website: landing for lightweight Docker images with optional blog and contact modules",
  "author": "Luis Alejandro <luis@luisalejandro.org>",
  "license": "GPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dockershelf/website.git"
  },
  "bugs": {
    "url": "https://github.com/Dockershelf/website/issues"
  },
  "homepage": "https://dockershelf.com",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/generate-agent-discovery.mjs",
    "optimize-images": "node scripts/strip-image-metadata.mjs",
    "postinstall": "update-browserslist-db --quiet",
    "build": "next build",
    "start": "next build && next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "agent-readiness:smoke": "bash scripts/agent-readiness-smoke.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.4.0",
