    "better-auth": "^1.6.23",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "classnames": "^2.5.1",
    "cryptr": "^6.4.0",
    "date-fns": "^4.4.0",
    "disqus-react": "^1.1.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "encoding": "^0.1.13",
    "feed": "^6.0.0",
    "framer-motion": "^12.42.0",
    "googleapis": "^173.0.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "html-react-parser": "^6.1.4",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lazysizes": "^5.3.2",
    "next": "^16.2.9",
    "prop-types": "^15.8.1",
